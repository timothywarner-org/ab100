# AB-100 POC environment template. Copy to src/.env and fill in.
# src/.env is gitignored.

# Azure subscription + resource group target
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
RESOURCE_GROUP=ab100-rg
LOCATION=eastus2
NAME_PREFIX=ab100

# Existing Foundry project + agent that the POC will call
PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
AGENT_ID=asst_xxxxxxxxxxxxxxxx
FOUNDRY_PROJECT_RESOURCE_ID=/subscriptions/.../resourceGroups/.../providers/Microsoft.CognitiveServices/accounts/<account>/projects/<project>

# Container image -- set by 01-build-and-push.sh after the first ACR build
CONTAINER_IMAGE=

# APIM publisher email (required by APIM service)
APIM_PUBLISHER_EMAIL=you@example.com
